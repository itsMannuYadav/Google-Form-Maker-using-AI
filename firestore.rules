rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: only the user themselves can read or write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Forms collection: only authenticated users can read, create, update, or delete their own forms
    match /forms/{formId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Audit logs: authenticated users can write logs for their own actions
    match /auditLogs/{logId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // immutable audit log
    }
  }
}
